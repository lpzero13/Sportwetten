[Unit]
Description=Sportwetten Optional FotMob Enrichment
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-/etc/default/tipico-observer
Environment=WETTEN_ARCHIVE_PATH=/var/lib/wetten/archive
Environment=PYTHONUNBUFFERED=1
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/scripts/run_fotmob.py --root __INSTALL_DIR__
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__INSTALL_DIR__/data __INSTALL_DIR__/logs /var/lib/wetten
UMask=0027

[Install]
WantedBy=multi-user.target
