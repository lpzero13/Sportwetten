[Unit]
Description=Sportwetten full Tipico result recovery (manual, resumable)
Wants=network-online.target
After=network-online.target wetten-collector.service

[Service]
Type=oneshot
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__INSTALL_DIR__
EnvironmentFile=-/etc/default/tipico-observer
Environment=WETTEN_ARCHIVE_PATH=/var/lib/wetten/archive
Environment=PYTHONUNBUFFERED=1
# This is an explicitly started initial/full inventory pass.  The database
# lease and persistent item checkpoints make interruption resumable.
ExecStart=__INSTALL_DIR__/.venv/bin/python __INSTALL_DIR__/scripts/result_finalization.py reconcile --root __INSTALL_DIR__ --full-inventory --apply --workers 10 --mode worker --refresh-index
TimeoutStartSec=infinity
TimeoutStopSec=60s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__INSTALL_DIR__/data __INSTALL_DIR__/logs /var/lib/wetten
UMask=0027
